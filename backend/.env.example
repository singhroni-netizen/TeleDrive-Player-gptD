# Bind to loopback by default. Set API_BIND=0.0.0.0 for LAN clients, with firewall + API key.
API_BIND=127.0.0.1

# Backend API protection. Use a long random value for any network-accessible server.
APP_API_KEY=replace-with-a-long-random-secret

# Telegram MTProto account session (only needed for Telegram source adapters).
# Get API_ID and API_HASH from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Optional runtime limits.
DATA_DIR=./data
REQUEST_TIMEOUT=45
MAX_JSON_BYTES=26214400
CATALOG_LIMIT=500

# Teldrive / generic REST tokens are referenced by env-variable name in source JSON.
# Example: configure a source with token_env=TELDRIVE_TOKEN and auth_header=X-Api-Key.
TELDRIVE_TOKEN=
MEDIA_API_TOKEN=

# Optional natural-language Gemini catalog search (the model remains configurable).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_CANDIDATE_LIMIT=250

# Optional Telegram compressor bot shortcut; the user must forward the media in Telegram.
TELEGRAM_COMPRESSOR_BOT=

# Optional downscale proxy. The Docker image includes FFmpeg.
TRANSCODE_ENABLED=true
FFMPEG_BINARY=ffmpeg
CORS_ORIGINS=*
